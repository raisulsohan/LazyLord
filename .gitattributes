# Windows batch files must keep CRLF line endings: with LF only, cmd.exe can
# misread ( ... ) blocks and labels.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must keep LF: with CRLF, bash reads "\r" as part of each
# command and a macOS .command installer fails on its first line.
*.command text eol=lf
*.sh text eol=lf
