<?xml version="1.0" encoding="UTF-8"?>
<!--
  LazyLord CEP panel — one extension, three hosts.
  Photoshop (PHXS/PHSP), Illustrator (ILST) and After Effects (AEFT).
-->
<ExtensionManifest Version="9.0" ExtensionBundleId="com.lazylord.panel"
    ExtensionBundleVersion="0.1.0" ExtensionBundleName="LazyLord"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.lazylord.panel" Version="0.1.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PHXS" Version="[22.0,99.9]" />
      <Host Name="PHSP" Version="[22.0,99.9]" />
      <Host Name="ILST" Version="[25.0,99.9]" />
      <Host Name="AEFT" Version="[18.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.lazylord.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>LazyLord</Menu>
          <Geometry>
            <Size><Height>360</Height><Width>300</Width></Size>
            <MinSize><Height>240</Height><Width>240</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
